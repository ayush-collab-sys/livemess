# Choose json, firestore, or postgres for the FastAPI backend.
MESSMIND_STORAGE=postgres

# Create the messmind database and run database/init.sql before starting FastAPI.
# Replace CHANGE_ME with your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/messmind

# Optional Firebase settings are only used when MESSMIND_STORAGE=firestore.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
